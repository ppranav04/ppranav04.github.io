---
import { profile, socials } from '../data/site';
import Photo from './Photo.astro';
---

<section id="about" class="hero">
  <div class="container">
    <div class="intro">
      <div class="text">
        <div class="prompt-line" aria-hidden="true">
          <span class="prompt">$</span> whoami
        </div>
        <h1 class="display">{profile.name}.<span class="cursor">_</span></h1>
        {profile.descriptors.length > 0 && (
          <p class="descriptors display" aria-label={profile.descriptors.join(' ')}>
            {profile.descriptors.map((d) => <span>{d}</span>)}
          </p>
        )}
        <p class="role">{profile.location}</p>
        <p class="tagline">{profile.tagline}</p>

        <div class="bio">
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>

        <ul class="skills">
          {profile.skills.map((s) => <li class="tag">{s}</li>)}
        </ul>

        <div class="actions">
          <a class="btn primary" href="#projects">view my work</a>
          <a class="btn" href={socials.github} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            github
          </a>
          <a class="btn" href={socials.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path fill="currentColor" d="M0 1.15C0 .52.52 0 1.17 0h13.66C15.48 0 16 .52 16 1.15v13.7c0 .63-.52 1.15-1.17 1.15H1.17C.52 16 0 15.48 0 14.85V1.15zM4.75 13.4V6.17h-2.4v7.23h2.4zM3.55 5.18c.84 0 1.36-.56 1.36-1.25-.02-.71-.52-1.25-1.34-1.25-.82 0-1.36.54-1.36 1.25 0 .7.52 1.25 1.33 1.25h.01zM6.08 13.4h2.4V9.36c0-.22.02-.43.08-.59.18-.43.57-.88 1.23-.88.87 0 1.21.66 1.21 1.63v3.88h2.4V9.26c0-2.22-1.18-3.25-2.76-3.25-1.27 0-1.84.7-2.16 1.2v.02h-.02l.02-.02V6.17h-2.4c.03.68 0 7.23 0 7.23z" />
            </svg>
            linkedin
          </a>
          {profile.resumeUrl && (
            <a class="btn" href={profile.resumeUrl} target="_blank" rel="noopener">
              resume.pdf
            </a>
          )}
        </div>
      </div>

      <Photo />
    </div>

  </div>
</section>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
    /* soft chrome glow, after the Obsidian Chrome palette */
    background:
      radial-gradient(ellipse 60% 50% at 70% 25%, rgba(83, 104, 120, 0.2), transparent 70%),
      radial-gradient(ellipse 45% 40% at 10% 85%, rgba(204, 208, 207, 0.04), transparent 70%);
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 3rem;
  }

  /* top of the photo lines up with the name: skip the "$ whoami" line (font-size x line-height + margin) */
  .intro :global(.photo) {
    margin-top: calc(0.9rem * 1.65 + 0.5rem);
  }

  .prompt-line {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .prompt {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(3.5rem, 11vw, 7rem);
    margin: 0;
    color: var(--text);
  }

  .cursor {
    color: var(--text);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .descriptors {
    display: flex;
    gap: 0.3em;
    white-space: nowrap;
    margin: 0.6rem 0 1.5rem;
    /* scales with the screen so the phrase stays on one line, even on a 320px phone */
    font-size: clamp(1.4rem, 7vw, 2.6rem);
    color: var(--blue-slate); /* a touch lighter than --slate so it passes 3:1 contrast */
  }

  .role {
    font-family: var(--font-mono);
    color: var(--muted);
    margin: 0;
  }

  /* spacing when there are no descriptors between the name and the role */
  h1 + .role {
    margin-top: 1rem;
  }

  .tagline {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    color: var(--text);
    margin: 0.5rem 0 1.5rem;
  }

  .bio {
    max-width: 620px;
    color: var(--muted);
  }

  .bio p {
    margin: 0 0 1rem;
  }

  .skills {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .intro :global(.photo) {
      order: -1;
      margin-top: 0;
    }
  }
</style>
