---
import fs from 'node:fs';
import path from 'node:path';
import { profile } from '../data/site';

// Only render the <img> if the file actually exists in /public
const hasPhoto = Boolean(profile.photo) && fs.existsSync(path.join(process.cwd(), 'public', profile.photo));
const initials = profile.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const filename = 'photo.jpg';
---

<figure class="photo hud">
  <div class="titlebar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">{filename}</span>
  </div>
  <div class="frame">
  {
    hasPhoto ? (
      <div class="clip"><img src={profile.photo} alt={`Photo of ${profile.name}`} width="300" height="375" /></div>
    ) : (
      <div class="placeholder">
        <span class="initials">{initials}</span>
        <span class="hint">add public/photo.jpg</span>
      </div>
    )
  }
  </div>
</figure>

<style>
  /* editor-style window */
  .photo {
    margin: 0;
    width: 300px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elev);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .titlebar {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .dots {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 0.4rem;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }

  .frame {
    aspect-ratio: 4 / 5;
    padding: 8px;
  }

  .clip {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: hidden;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px dashed var(--border);
    border-radius: 3px;
    font-family: var(--font-mono);
  }

  .initials {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 800;
    letter-spacing: -0.055em;
    color: var(--chrome);
    text-shadow: 0 0 24px var(--glow);
  }

  .hint {
    font-size: 0.75rem;
    color: var(--dim);
  }

  @media (max-width: 820px) {
    .photo {
      width: 220px;
    }
    .initials {
      font-size: 3.25rem;
    }
  }
</style>
