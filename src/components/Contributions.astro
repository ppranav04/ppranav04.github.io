---
// GitHub card under the hero photo: a 6-month contribution graph plus profile stats.
// Everything loads in the browser from public APIs and keeps updating while the page is open.
import { socials } from '../data/site';

const user = socials.github.split('/').filter(Boolean).pop();
const months = 4; // rolling window shown in the graph
---

<div class="gh" data-gh data-user={user} data-window={months}>
  <div class="head">
    <span class="label">github</span>
    <a href={socials.github} target="_blank" rel="noopener">@{user} ↗</a>
  </div>

  <div class="cells" data-cells role="img" aria-label={`GitHub contributions over the last ${months} months`}></div>

  <div class="legend">
    <span>last {months} months</span>
    <span class="scale" aria-hidden="true">
      less <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> more
    </span>
  </div>

  <dl class="stats">
    <div class="row">
      <div><dd data-total>—</dd><dt>contributions / yr</dt></div>
      <div><dd data-repos>—</dd><dt>repos</dt></div>
    </div>
    <div class="row">
      <div><dt>top</dt><dd data-lang>—</dd></div>
      <div><dt>pushed</dt><dd data-pushed>—</dd></div>
    </div>
  </dl>
</div>

<script>
  type Day = { date: string; count: number; level: number };

  const root = document.querySelector<HTMLElement>('[data-gh]');
  if (root) init(root);

  // Keeps the card live while the page is open. The graph data is cached upstream for
  // ~30 min, so the repo list (polled every minute) fills the gap: a push today lights up
  // today's square and updates "pushed" without a reload.
  function init(root: HTMLElement) {
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const user = root.dataset.user!;
    const months = Number(root.dataset.window);
    const iso = (d: Date) => d.toLocaleDateString('en-CA'); // YYYY-MM-DD, local time

    let days: Day[] = []; // last year, from the contributions API
    let total = 0;
    let lastPush = 0; // ms timestamp

    async function loadGraph() {
      try {
        const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${user}?y=last`, { cache: 'no-cache' });
        if (!res.ok) return;
        const data: { contributions: Day[] } = await res.json();
        days = data.contributions;
        total = days.reduce((n, d) => n + d.count, 0);
        draw();
      } catch {}
    }

    // Repo count, top two languages (by number of repos) and the latest push time.
    // Polled every minute; the browser revalidates with an ETag, and GitHub doesn't count
    // unchanged (304) responses against its rate limit.
    async function loadRepos() {
      try {
        const r = await fetch(`https://api.github.com/users/${user}/repos?per_page=100&type=owner`, { cache: 'no-cache' });
        if (!r.ok) return;
        const repos: { fork: boolean; language: string | null; pushed_at: string }[] = await r.json();
        const own = repos.filter((x) => !x.fork);
        const langs = new Map<string, number>();
        for (const x of own) if (x.language) langs.set(x.language, (langs.get(x.language) || 0) + 1);
        const top = [...langs].sort((a, b) => b[1] - a[1]).slice(0, 2).map(([l]) => l);

        q('[data-repos]').textContent = String(own.length);
        if (top.length) q('[data-lang]').textContent = top.join(' · ');
        lastPush = Math.max(0, ...own.map((x) => Date.parse(x.pushed_at)));
        showPushed();
        draw();
      } catch {}
    }

    function showPushed() {
      if (lastPush) q('[data-pushed]').textContent = ago(lastPush);
    }

    function draw() {
      if (!days.length) return;
      const now = new Date();
      const today = iso(now);
      const start = new Date(now);
      start.setMonth(start.getMonth() - months);
      const since = iso(start);

      // copy the window, filling any days the cached data hasn't reached yet
      const byDate = new Map(days.map((d) => [d.date, d]));
      const shown: Day[] = [];
      for (const d = new Date(since + 'T00:00:00'); iso(d) <= today; d.setDate(d.getDate() + 1)) {
        const key = iso(d);
        shown.push({ ...(byDate.get(key) ?? { date: key, count: 0, level: 0 }) });
      }

      // a push today that the cached data hasn't counted yet still lights up today's square
      const last = shown[shown.length - 1];
      const extra = lastPush && iso(new Date(lastPush)) === today && last.count === 0 ? 1 : 0;
      if (extra) {
        last.count = 1;
        last.level = 1;
      }
      q('[data-total]').textContent = (total + extra).toLocaleString('en');
      render(shown, q('[data-cells]'));
    }

    loadGraph();
    loadRepos();

    // refresh while the tab is visible; catch up straight away when it comes back
    const live = () => !document.hidden;
    setInterval(() => live() && loadRepos(), 60e3);
    setInterval(() => live() && loadGraph(), 10 * 60e3);
    setInterval(() => live() && showPushed(), 30e3);
    document.addEventListener('visibilitychange', () => {
      if (live()) {
        loadRepos();
        loadGraph();
      }
    });
  }

  // short relative time: "5m ago", "7h ago", "3d ago"
  function ago(ms: number) {
    const steps: [number, string][] = [
      [60, 's'],
      [60, 'm'],
      [24, 'h'],
      [30, 'd'],
      [12, 'mo'],
      [Infinity, 'y'],
    ];
    let v = Math.max(0, (Date.now() - ms) / 1000);
    for (const [size, unit] of steps) {
      if (v < size) return unit === 's' ? 'just now' : `${Math.floor(v)}${unit} ago`;
      v /= size;
    }
    return '';
  }

  // Full rectangle of squares: Sunday-to-Saturday columns, with the days before the
  // window and the rest of this week shown as empty squares.
  function render(days: Day[], cells: HTMLElement) {
    const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
    const parse = (d: string) => new Date(d + 'T00:00:00');
    const square = (cls: string) => {
      const s = document.createElement('span');
      s.className = cls;
      return s;
    };

    const lead = parse(days[0].date).getDay();
    const trail = 6 - parse(days[days.length - 1].date).getDay();
    const frag = document.createDocumentFragment();
    for (let i = 0; i < lead; i++) frag.append(square('c l0'));
    for (const d of days) {
      const cell = square(`c l${d.level}`);
      const n = d.count === 0 ? 'No' : d.count;
      cell.title = `${n} contribution${d.count === 1 ? '' : 's'} on ${fmt.format(parse(d.date))}`;
      frag.append(cell);
    }
    for (let i = 0; i < trail; i++) frag.append(square('c future'));
    cells.style.setProperty('--weeks', String((lead + days.length + trail) / 7));
    cells.replaceChildren(frag);
  }
</script>

<style>
  .gh {
    width: 300px;
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elev);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--slate);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.9rem;
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .head a {
    color: var(--muted);
    text-decoration: none;
  }

  .head a:hover {
    color: var(--text);
  }

  /* squares stretch to fill the card width, one column per week */
  .cells {
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-template-columns: repeat(var(--weeks, 27), 1fr);
    grid-auto-flow: column;
    gap: 2px;
    min-height: 60px;
  }

  .cells :global(span) {
    aspect-ratio: 1;
  }

  .cells :global(.c),
  .legend i {
    border-radius: 2px;
    background: var(--border);
  }

  .cells :global(.future) {
    opacity: 0.4;
  }

  .cells :global(.c:hover) {
    outline: 1px solid var(--text);
  }

  .cells :global(.l1),
  .legend .l1 {
    background: rgba(var(--accent-rgb), 0.35);
  }

  .cells :global(.l2),
  .legend .l2 {
    background: rgba(var(--accent-rgb), 0.6);
  }

  .cells :global(.l3),
  .legend .l3 {
    background: rgba(var(--accent-rgb), 0.85);
  }

  .cells :global(.l4),
  .legend .l4 {
    background: var(--chrome);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .scale {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .legend i {
    width: 9px;
    height: 9px;
  }

  .legend i:first-of-type {
    margin-left: 0.35rem;
  }

  .legend i:last-of-type {
    margin-right: 0.35rem;
  }

  .stats {
    display: grid;
    gap: 0.7rem;
    margin: 1.1rem 0 0;
  }

  /* each row: left item and right item; wraps instead of overflowing on narrow cards */
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  .row > div {
    display: flex;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .stats dd {
    margin: 0;
    color: var(--text);
  }

  @media (max-width: 820px) {
    .gh {
      width: auto;
      max-width: 300px;
    }
  }
</style>
