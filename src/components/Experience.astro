---
import { experience, education, profile, type Entry } from '../data/site';

const groups: { label: string; entries: Entry[] }[] = [
  { label: 'work', entries: experience },
  { label: 'education', entries: education },
];
---

<section id="experience">
  <div class="container">
    <h2 class="section-title">experience</h2>

    {
      groups
        .filter((g) => g.entries.length > 0)
        .map((g) => (
          <div class="group">
            <h3 class="group-label">// {g.label}</h3>
            <ol class="timeline">
              {g.entries.map((e) => (
                <li>
                  <div class="head">
                    <h4>
                      {e.title} <span class="org">@ {e.org}</span>
                    </h4>
                    <span class="period">{e.period}</span>
                  </div>
                  <ul>
                    {e.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </div>
        ))
    }

    {
      profile.resumeUrl && (
        <a class="btn" href={profile.resumeUrl} target="_blank" rel="noopener">
          download full resume
        </a>
      )
    }
  </div>
</section>

<style>
  .group {
    margin-bottom: 2.5rem;
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--border);
  }

  .timeline > li {
    position: relative;
    padding-bottom: 1.75rem;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 0.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 8px var(--glow);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  h4 {
    margin: 0;
    font-size: 1.1rem;
  }

  .org {
    color: var(--muted);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  ul {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  ul li::marker {
    color: var(--accent);
    content: '▹ ';
  }
</style>
